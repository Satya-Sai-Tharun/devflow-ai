# Local development placeholders only. Never use these values in production.
# Compose overrides DEVFLOW_DATABASE_URL to use the in-network postgres service.
DEVFLOW_ENV=local
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_LOG_FORMAT=text
DEVFLOW_API_HOST=127.0.0.1
DEVFLOW_API_PORT=8000
DEVFLOW_DATABASE_URL=postgresql+asyncpg://devflow:replace_me_local_only@127.0.0.1:5432/devflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=replace_me_local_only
